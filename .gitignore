# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/

*.egg-info/
*.egg
*.whl
*.spec

# Virtual environments
venv/
env/
.venv/

# PyInstaller / Nuitka artifacts
*.manifest
*.log
# Nuitka standalone output may create a dist/ directory
# PyInstaller creates dist/ and build/ directories

# Editor / OS files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Test / coverage
.pytest_cache/
.coverage
coverage.xml

# Local env files
.env
*.env

# Optional generated meter data files
# Eğer "ZD5ME666-1003_data.txt" ve "ZD5ME666-1003_total_endex.txt" sadece runtime sırasında oluşturuluyorsa uncomment edin:
# ZD5ME666-1003_data.txt
# ZD5ME666-1003_total_endex.txt
